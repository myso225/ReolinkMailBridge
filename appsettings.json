{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "SingleLine": true, "TimestampFormat": "yyyy-MM-dd HH:mm:ss " }
    }
  },
  "Bridge": {
    "Smtp": {
      "Port": 25,
      "Username": "",
      "Password": ""
    },
    "Mqtt": {
      "Host": "192.168.1.79",
      "Port": 1883,
      "Username": "",
      "Password": "",
      "BaseTopic": "reolink",
      "DiscoveryPrefix": "homeassistant"
    },
    "MotionOffDelaySeconds": 30,
    "ActivityWindowHours": 8,
    "DataDirectory": "data",
    "SaveMailDirectory": "data/mail",
    "MaxSavedMails": 200,
    "BatteryReadDelaySeconds": 5,
    "BatteryFallbackHours": 6,
    "Cameras": [
      { "Name": "Garage", "Model": "Argus Eco Pro", "SenderAddress": "garage@reolink.local",
        "Ip": "", "Uid": "", "Username": "admin", "Password": "" },
      { "Name": "Garden", "Model": "Argus Eco Pro", "SenderAddress": "garden@reolink.local",
        "Ip": "", "Uid": "", "Username": "admin", "Password": "" }
    ]
  }
}
